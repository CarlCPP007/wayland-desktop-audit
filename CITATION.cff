    website: "https://github.com/CarlCPP007"
date-released: "2026-09-23"
license: MIT
url: "https://github.com/CarlCPP007/wayland-desktop-audit"
repository-code: "https://github.com/CarlCPP007/wayland-desktop-audit"
keywords:
  - arch-linux
  - wayland
  - hyprland
  - dependency-resolution
  - package-closure
  - desktop-environment
